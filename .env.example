
# Neon Environment Variables
# Copy this file to .env.local and fill in values from `neon deploy`

# =============================================================================
# NEON POSTGRES
# =============================================================================
# Pooled connection (use for app queries via Drizzle ORM)
DATABASE_URL=

# Direct/unpooled connection (use for Drizzle Kit migrations ONLY)
DATABASE_URL_UNPOOLED=

# =============================================================================
# NEON AUTH (Better Auth)
# =============================================================================
# Your app's URL — used for auth redirects
BETTER_AUTH_URL=http://localhost:3000

# Secret for signing auth tokens — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Neon Auth service URL (provided by neon deploy)
NEON_AUTH_URL=

# =============================================================================
# NEON OBJECT STORAGE (S3-compatible)
# =============================================================================
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=

# =============================================================================
# NEON AI GATEWAY
# =============================================================================
NEON_AI_GATEWAY_API_KEY=
NEON_AI_GATEWAY_URL=

# =============================================================================
# APP CONFIG
# =============================================================================
NODE_ENV=development

# File upload max size in bytes (5 MiB = 5242880)
MAX_UPLOAD_SIZE_BYTES=5242880

# Private file storage path for development (outside public/)
PRIVATE_STORAGE_PATH=./private-storage

# Timezone (for display only — all timestamps stored in UTC)
TZ=Asia/Jakarta
